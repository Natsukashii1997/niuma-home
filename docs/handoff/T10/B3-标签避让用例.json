{
  "schemaVersion": 1,
  "purpose": "T10 B3 计算方案验证；全部为合成输入，不是真实Voice话题。",
  "algorithm": "stable-sort-forward-backward-v1",
  "defaults": {
    "chart": {
      "W": 1000,
      "H": 220,
      "L": 40,
      "R": 260,
      "T": 12,
      "B": 26
    },
    "labelHeight": 16,
    "gap": 6,
    "baselineOffset": 4,
    "textX": 750,
    "leaderStartX": 744,
    "leaderEndX": 748
  },
  "inputContract": {
    "lastValue": "实际组件从spark.at(-1)取得；有限数值0到100。heat仅保留展示，不参与标签定位。",
    "labelHeight": "所有标签字体加载后的最大包围盒对应的统一对称槽高，至少16 SVG单位。",
    "coordinates": "全部以SVG viewBox单位计算；标签中心labelY，文字baseline=labelY+4；不能用屏幕CSS像素混算。",
    "ids": "稳定唯一ID；同末点y按ID的确定性代码单元顺序排序，不改变源数组或第一名高亮。"
  },
  "assertions": [
    "输出符合手工给定预期，容差1e-9",
    "每个标签槽完整落在[T,H-B]内",
    "相邻槽中心距至少labelHeight+gap",
    "仅生成labelY映射，不修改topics或lastValue/heat",
    "同一输入确定性；相同末值的标签顺序不依赖输入数组顺序",
    "放不下时返回全部话题的图例退化，不输出重叠的end-label"
  ],
  "cases": [
    {
      "name": "空集合",
      "topics": [],
      "expected": {
        "mode": "labels",
        "labelYById": {}
      }
    },
    {
      "name": "单标签保持末点",
      "topics": [
        {
          "id": "A",
          "lastValue": 50,
          "heat": 50
        }
      ],
      "expected": {
        "mode": "labels",
        "labelYById": {
          "A": 103
        }
      }
    },
    {
      "name": "互不冲突保持原位",
      "topics": [
        {
          "id": "A",
          "lastValue": 90,
          "heat": 90
        },
        {
          "id": "B",
          "lastValue": 70,
          "heat": 70
        },
        {
          "id": "C",
          "lastValue": 50,
          "heat": 50
        },
        {
          "id": "D",
          "lastValue": 20,
          "heat": 20
        }
      ],
      "expected": {
        "mode": "labels",
        "labelYById": {
          "A": 30.2,
          "B": 66.6,
          "C": 103,
          "D": 157.6
        }
      }
    },
    {
      "name": "两话题末值相同",
      "topics": [
        {
          "id": "A",
          "lastValue": 50,
          "heat": 50
        },
        {
          "id": "B",
          "lastValue": 50,
          "heat": 50
        }
      ],
      "expected": {
        "mode": "labels",
        "labelYById": {
          "A": 103,
          "B": 125
        }
      }
    },
    {
      "name": "四话题相同且输入乱序",
      "topics": [
        {
          "id": "D",
          "lastValue": 50,
          "heat": 50
        },
        {
          "id": "B",
          "lastValue": 50,
          "heat": 50
        },
        {
          "id": "A",
          "lastValue": 50,
          "heat": 50
        },
        {
          "id": "C",
          "lastValue": 50,
          "heat": 50
        }
