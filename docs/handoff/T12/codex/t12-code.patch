+  const seen=new Set(); let total=0;
+  const rules=rows.map(row=>{
+    if(!row||!validNodeToken(row.nodeToken)||seen.has(row.nodeToken)||typeof row.title!=='string'||!row.title.trim()||!Array.isArray(row.keywords))bad();
