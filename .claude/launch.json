{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "work-desk",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "port": 5280
    },
    {
      "name": "work-desk-iso",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "WORKDESK_DATA_DIR=$(mktemp -d) PORT=5290 npm start"
      ],
      "port": 5290
    },
    {
      "name": "kb-drafts",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "5297",
        "--bind",
        "127.0.0.1"
      ],
      "port": 5297
    },
    {
      "name": "work-desk-dev-live",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5293"
      ],
      "port": 5293
    },
    {
      "name": "work-desk-iso-5296",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "WORKDESK_DATA_DIR=$(mktemp -d) PORT=5296 npm start"
      ],
      "port": 5296
    }
  ]
}