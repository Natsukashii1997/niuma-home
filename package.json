  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.3"
  }
}
